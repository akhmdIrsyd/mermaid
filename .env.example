# PostgreSQL Database
POSTGRES_USER=mermaid
POSTGRES_PASSWORD=mermaid_secret
POSTGRES_DB=mermaid_studio
POSTGRES_PORT=5439

# Backend API (Express + TypeScript)
BACKEND_PORT=4000
JWT_SECRET=ganti-dengan-random-string-panjang-minimal-32-karakter
JWT_EXPIRES_IN=30d
CORS_ORIGIN=*

# Super Admin Default (otomatis dibuat saat startup pertama)
SUPER_ADMIN_EMAIL=admin@mermaid.local
SUPER_ADMIN_PASSWORD=Admin123456!
SUPER_ADMIN_NAME=Super Admin

# Frontend Web (React + Nginx)
FRONTEND_PORT=5173
